# Create a free Supabase project at https://supabase.com, then copy
# the Project URL and anon (public) key from Settings → API.
# Copy this file to .env.local and fill in the values.
# The anon key is safe to expose publicly — row-level security
# in the database restricts access per authenticated user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
