# -- Supabase (auth + progress sync) --
# Free project at https://supabase.com, keys in Settings → API.
# Publishable / anon key is safe to commit — RLS restricts access per user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -- Paddle (subscription checkout) --
# Create a seller account at https://paddle.com, get the CLIENT-side token
# from Developer Tools → Authentication. Create a product priced at
# THB 1,000 / year with a 3-day trial and copy the PRICE ID (pri_...).
# Start in the sandbox until your live account is approved.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=
